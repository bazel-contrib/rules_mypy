load("@rules_python//python:py_library.bzl", "py_library")

genrule(
    name = "generate_stubs",
    outs = ["separate_stubs/gen/values.pyi"],
    cmd = "echo 'VALUE: int' > $@",
)

py_library(
    name = "stubs",
    imports = ["."],
    pyi_srcs = [":generate_stubs"],
    visibility = ["//visibility:public"],
    deps = ["//separate_stubs/gen:values"],
)
