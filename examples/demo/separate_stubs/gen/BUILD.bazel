load("@rules_python//python:py_library.bzl", "py_library")

genrule(
    name = "generate_module",
    outs = ["values.py"],
    cmd = "echo 'globals()[\"VALUE\"] = 42' > $@",
)

py_library(
    name = "values",
    srcs = [":generate_module"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
)
